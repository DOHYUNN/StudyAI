# Pages server only. Never put the ChatKHU key in VITE_ variables.
# Set true only after checking school-provided credits and no paid top-up.
CHATKHU_CREDITS_CONFIRMED=false
CHATKHU_API_KEY=
# Exact available Gemini model ID from ChatKHU /v1/gateway/models/.
# Optional: leave blank to select a Gemini model from the gateway model list.
CHATKHU_MODEL=
# Output limit only; input and thinking tokens are not included.
CHATKHU_MAX_OUTPUT_TOKENS=512
# At least 16 characters, separate from the API key. Private chat access without Supabase.
STUDYAI_ACCESS_CODE=
# Optional: enable Supabase later for cloud records / alternative session auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
