# Public Supabase URL and publishable/anon key only. Never use service_role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public Supabase publishable key; legacy anon key above also works.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable only providers configured in Supabase: google
VITE_AUTH_PROVIDERS=google

# Enable only after applying supabase/schema.sql and checking per-user RLS.
VITE_PROFILE_SYNC_ENABLED=false
